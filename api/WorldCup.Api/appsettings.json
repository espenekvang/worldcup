{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:sql-worldcup-ekvang.database.windows.net,1433;Database=sqldb-worldcup;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;"
  },
  "Wc2026Api": {
    "ApiKey": "",
    "BaseUrl": "https://api.wc2026api.com"
  },
  "FeatureManagement": {
    "AiPredictions": {
      "EnabledFor": [
        {
          "Name": "BettingGroup",
          "Parameters": {
            "GroupIds": []
          }
        }
      ]
    },
